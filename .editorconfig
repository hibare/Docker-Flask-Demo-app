# Managed by Axon; manual edits will be overwritten.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[Dockerfile*]
indent_size = 4

[{*.rb,Gemfile}]
indent_size = 2

[.git*]
trim_trailing_whitespace = false
